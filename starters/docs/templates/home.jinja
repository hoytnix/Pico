{% extends "skeleton.jinja" %}
{% from "macros/cards.jinja" import post_card %}

{% block title %}Documentation — {{ site.title }}{% endblock %}

{% block content %}
<div class="docs-layout">
  <aside class="docs-sidebar">
    <h3>Documentation</h3>
    <ul style="list-style: none; padding: 0; margin: 0;">
      {% for post in all_posts %}
        <li style="margin: 0.45rem 0;"><a href="{{ post.url }}">{{ post.title }}</a></li>
      {% endfor %}
    </ul>
  </aside>
  <section>
    <h1>{{ site.title }} Documentation</h1>
    <p>{{ site.description }}</p>
    <div class="card-grid">
      {% for post in posts %}
        {{ post_card(post) }}
      {% endfor %}
    </div>
  </section>
</div>
{% endblock %}
