{% extends "skeleton.jinja" %}
{% from "macros/cards.jinja" import post_card %}

{% block title %}{{ site.title }} — Home{% endblock %}

{% block content %}
<section class="hero-banner" style="margin-bottom: 2.5rem;">
  <h1>{{ site.title }}</h1>
  <p style="font-size: 1.15rem; color: var(--muted);">{{ site.description }}</p>
</section>

<section>
  <h2>Latest Posts</h2>
  <div class="card-grid">
    {% for post in posts %}
      {{ post_card(post) }}
    {% endfor %}
  </div>
</section>
{% endblock %}
