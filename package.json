{
  "name": "pico",
  "private": true,
  "version": "0.1.0",
  "description": "Pico — Desktop Static Site Generator with Milkdown Crepe & MiniJinja",
  "license": "Kopimi",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vite",
